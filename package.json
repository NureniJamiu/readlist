{
  "name": "readlist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReadList - A lightweight book tracking web application",
  "workspaces": [
    "contracts",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "eval": "npm run eval --workspaces --if-present",
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:web": "npm run dev --workspace=services/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
